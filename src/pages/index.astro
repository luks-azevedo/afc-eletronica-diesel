---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import StripeBand from '../components/sections/StripeBand.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import VisitSection from '../components/sections/VisitSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, services, vehicles, brands, steps, faq } from '../data/afc';
import { slogan, whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
const orcamento = whatsappUrl(whatsappMessages.orcamento) ?? '/contato';
const homeServices = services.map((s) => ({ ...s, href: `/servicos#${s.id}` }));
---

<BaseLayout>
  <Hero
    variant="cover"
    coverTone="inverted"
    eyebrow="Eletrônica diesel · Conselheiro Lafaiete"
    title={slogan}
    description="Eletrônica embarcada, gerenciamento do motor e câmbio, injeção diesel e emissões para caminhões, ônibus e vans."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Ver serviços', href: '/servicos' }}
    image={photos.hero}
  />

  <StripeBand lead="Mecatrônica diesel" items={brands} flag={false} />

  <ServicesSection
    eyebrow="Serviços"
    title="Especialistas no que move o seu veículo"
    description="Do diagnóstico eletrônico à injeção e ao Arla 32: serviços para manter caminhões, ônibus e vans trabalhando."
    items={homeServices}
    cta={{ label: 'Todos os serviços', href: '/servicos' }}
  />

  <BenefitsSection tone="inverted" id="veiculos" eyebrow="Veículos atendidos" title="Da van ao cavalo mecânico" items={vehicles} />

  <AboutSection
    eyebrow="A AFC"
    title="Estrutura no bairro Paulo VI"
    paragraphs={[
      'A AFC Eletrônica Diesel atende caminhões, ônibus e vans em Conselheiro Lafaiete, com foco em eletrônica embarcada, gerenciamento do motor e câmbio.',
      'O atendimento é de segunda a sexta, das 8h às 18h, com agendamento pelo WhatsApp.',
    ]}
    image={photos.caminhao}
    imagePosition="right"
    cta={{ label: 'Conheça a AFC', href: '/sobre' }}
  />

  <BenefitsSection tone="muted" id="como-funciona" eyebrow="Como funciona" title="Do agendamento à entrega" items={steps} variant="numbered" />

  <CTASection
    variant="card"
    title="Luz de falha acesa no painel?"
    description="Informe marca, modelo e ano do veículo pelo WhatsApp e solicite um orçamento."
    primaryCta={{ label: 'Pedir orçamento', href: orcamento }}
    secondaryCta={{ label: 'Ver serviços', href: '/servicos' }}
  />

  <VisitSection
    eyebrow="Visite"
    title="Horário e endereço"
    description="Av. Geraldo Plaza, no bairro Paulo VI."
    whatsappMessage={whatsappMessages.agendar}
    whatsappLabel="Agendar pelo WhatsApp"
  />

  <FAQSection tone="muted" eyebrow="Dúvidas" title="Perguntas frequentes" items={faq} />
</BaseLayout>
