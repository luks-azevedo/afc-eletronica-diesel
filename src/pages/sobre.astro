---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import GallerySection from '../components/sections/GallerySection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { photos, gallery } from '../data/afc';
import { whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
---

<BaseLayout
  title="Sobre"
  description="Conheça a AFC Eletrônica Diesel: eletrônica embarcada, gerenciamento do motor e câmbio para veículos diesel em Conselheiro Lafaiete."
>
  <Hero
    variant="page"
    eyebrow="Sobre"
    title="Eletrônica diesel em Conselheiro Lafaiete"
    description="Eletrônica embarcada, gerenciamento do motor e câmbio para caminhões, ônibus e vans."
  />

  <AboutSection
    id="empresa"
    eyebrow="A AFC"
    title="Foco na eletrônica do veículo diesel"
    paragraphs={[
      'A AFC Eletrônica Diesel trabalha com os sistemas que comandam o veículo: módulos, sensores, gerenciamento do motor e do câmbio, injeção e emissões.',
      'Atende caminhões leves, médios e pesados, ônibus e vans, com mecatrônica diesel para Mercedes-Benz, Scania e Volvo.',
      'A oficina fica na Av. Geraldo Plaza, 920, bairro Paulo VI, e funciona de segunda a sexta, das 8h às 18h.',
    ]}
    image={photos.picape}
  />

  <GallerySection tone="muted" eyebrow="Estrutura" title="Nossa oficina" images={gallery} />

  <CTASection
    title="Agende o atendimento do seu veículo"
    description="Fale com a AFC pelo WhatsApp."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Ver serviços', href: '/servicos' }}
  />
</BaseLayout>
