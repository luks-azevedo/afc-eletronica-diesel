---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ServicesSection from '../components/sections/ServicesSection.astro';
import BenefitsSection from '../components/sections/BenefitsSection.astro';
import CTASection from '../components/sections/CTASection.astro';
import { services, vehicles } from '../data/afc';
import { whatsappMessages } from '../config/site';
import { whatsappUrl } from '../lib/contact';

const agendar = whatsappUrl(whatsappMessages.agendar) ?? '/contato';
---

<BaseLayout
  title="Serviços"
  description="Diagnóstico com scanner, reparo e programação de módulos, injeção diesel, common rail, Arla 32, DPF/EGR, tacógrafo, mecânica e ar-condicionado para veículos diesel."
>
  <Hero
    variant="page"
    eyebrow="Serviços"
    title="Eletrônica, injeção diesel e emissões"
    description="Serviços para caminhões, ônibus e vans Mercedes-Benz, Scania e Volvo, com agendamento pelo WhatsApp."
    primaryCta={{ label: 'Agendar pelo WhatsApp', href: agendar }}
  />

  <ServicesSection id="lista-servicos" title="O que fazemos" items={services} variant="list" />

  <BenefitsSection tone="inverted" id="veiculos" eyebrow="Veículos atendidos" title="Da van ao cavalo mecânico" items={vehicles} />

  <CTASection
    title="Não encontrou o serviço?"
    description="Fale com a equipe pelo WhatsApp e informe o veículo e o problema."
    primaryCta={{ label: 'Falar pelo WhatsApp', href: agendar }}
    secondaryCta={{ label: 'Horário e endereço', href: '/contato' }}
  />
</BaseLayout>
