---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import VisitSection from '../components/sections/VisitSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import { faq } from '../data/afc';
import { whatsappMessages } from '../config/site';
---

<BaseLayout
  title="Contato e agendamento"
  description="Agende pelo WhatsApp (31) 99740-3594. Av. Geraldo Plaza, 920 – Paulo VI, Conselheiro Lafaiete. Segunda a sexta, 8h às 18h."
>
  <Hero
    variant="page"
    eyebrow="Contato"
    title="Agende o atendimento"
    description="O agendamento é feito pelo WhatsApp. Atendimento de segunda a sexta, das 8h às 18h."
  />

  <VisitSection
    id="agendar"
    eyebrow="Agendamento"
    title="Fale com a AFC"
    description="Informe marca, modelo e ano do veículo e o que está acontecendo."
    whatsappMessage={whatsappMessages.agendar}
    whatsappLabel="Agendar pelo WhatsApp"
  />

  <FAQSection tone="muted" eyebrow="Dúvidas" title="Antes de vir" items={faq} />
</BaseLayout>
