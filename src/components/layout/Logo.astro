---
/**
 * Logotipo a partir de site.logo:
 * - src            → imagem
 * - src + wordmark → símbolo (imagem) + nome em texto ao lado
 * - wordmark       → logotipo tipográfico
 * - nada           → nome da empresa com a fonte de títulos
 */
import { site } from '../../config/site';

interface Props {
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: className } = Astro.props;
const { logo } = site;
const src = inverted && logo.srcInverted ? logo.srcInverted : logo.src;
---

{
  src && logo.wordmark ? (
    <span class:list={['inline-flex items-center gap-3', className]}>
      <img src={src} alt="" width={logo.width} height={logo.height} class="h-10 w-auto sm:h-11" decoding="async" />
      <span class="inline-flex flex-col leading-none">
        <span class="font-heading text-lg tracking-[0.02em] sm:text-xl">{logo.wordmark}</span>
        {logo.tagline && (
          <span class="mt-1 text-[0.625rem] font-semibold tracking-[0.22em] uppercase opacity-75">{logo.tagline}</span>
        )}
      </span>
    </span>
  ) : src ? (
    <img
      src={src}
      alt={logo.alt || site.name}
      width={logo.width}
      height={logo.height}
      class:list={['h-8 w-auto sm:h-9', className]}
      decoding="async"
    />
  ) : logo.wordmark ? (
    <span class:list={['inline-flex flex-col leading-none', className]}>
      <span class="font-heading text-[1.375rem] tracking-[0.3em] sm:text-[1.5rem]">{logo.wordmark}</span>
      {logo.tagline && (
        <span class="mt-1.5 text-[0.625rem] font-medium tracking-[0.22em] uppercase opacity-75">{logo.tagline}</span>
      )}
    </span>
  ) : (
    <span class:list={['font-heading text-xl leading-none font-semibold tracking-[-0.02em] sm:text-[1.375rem]', className]}>
      {site.name}
    </span>
  )
}
